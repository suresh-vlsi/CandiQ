# Crustdata (leave blank to use mock candidate data)
CRUSTDATA_API_KEY=
CRUSTDATA_API_VERSION=2025-11-01
# CRUSTDATA_BASE_URL=https://api.crustdata.com
# CRUSTDATA_DISABLE_CACHE=0
# CRUSTDATA_CACHE_DIR=.cache

# Gemini (required for LLM-powered pipeline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_RPM=4

# Optional OpenAI-compatible provider (Groq/OpenRouter/etc.)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_RPM=4

# Search/pipeline tuning
MIN_CANDIDATES=12
SEARCH_LIMIT=25
MAX_SEARCH_PAGES=3
